# Cua vao duy nhat cua CapyMedi tren VPS (ADR-0015). Caddy tu xin + tu gia han
# chung chi HTTPS (Let's Encrypt) cho {$DOMAIN}.
#
# 1 domain cho ca web va API: /api/v1/* (backend FastAPI) khong trung route
# nao cua Next.js (Next chi co /api/auth, /api/chat, ... khong co /api/v1).
{$DOMAIN} {
	encode zstd gzip

	@backend path /api/v1/* /health /docs /docs/* /openapi.json /redoc
	handle @backend {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
